# === WordPress 主站的預設路由 ===
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]

# 💡 終極解鎖：強制將所有對 dolly 子目錄的語系轉導（如 /dolly/tw/），精準鎖定在 dolly 內部處理，禁止 Apache 越界！
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^dolly/(.*)$ /dolly/index.php/$1 [L]

# === WordPress 的剩餘路由 ===
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
