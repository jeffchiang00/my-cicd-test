<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <WatchedResource>WEB-INF/web.xml</WatchedResource>
    <WatchedResource>${catalina.base}/conf/web.xml</WatchedResource>

    <!-- 方案：直接在 Context 層級宣告，這是最不易踩雷的綁定方式 -->
    <Resource name="jdbc/ds_global"
              auth="Container"
              type="javax.sql.DataSource"
              maxTotal="100"
              maxIdle="30"
              maxWaitMillis="10000"
              username="axe_user"
              password="axe_1234"
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="jdbc:mysql://tomcat_db:3306/axe_project_db?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC"/>

    <!-- 雙重保障：防範專案程式碼有加或沒加 "jdbc/" 前綴 -->
    <Resource name="ds_global"
              auth="Container"
              type="javax.sql.DataSource"
              maxTotal="100"
              maxIdle="30"
              maxWaitMillis="10000"
              username="axe_user"
              password="axe_1234"
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="jdbc:mysql://tomcat_db:3306/axe_project_db?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC"/>
</Context>
